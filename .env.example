PORT=3001
HOST=127.0.0.1
# Leave empty to use the embedded PostgreSQL development engine.
DATABASE_URL=
DATA_DIR=.data
# DEMO_MODE must be false in production. Demo users use this password.
DEMO_MODE=true
DEMO_PASSWORD=
# First administrator for a non-demo deployment. Minimum 12 characters.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Set true behind HTTPS in production.
COOKIE_SECURE=false

# Set true only after separately applying server/schema.sql with the owner.
SKIP_SCHEMA=false
