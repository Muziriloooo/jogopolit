{
  "name": "sl-campo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:server\" \"npm:client\"",
    "server": "node --watch --env-file-if-exists=.env server/index.js",
    "client": "node tooling/start-client.js",
    "build": "tsc --noEmit && vite build && node server/precache.js",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:browser": "python3 tests/run-browser-fixture.py tests/browser.py",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write src server tooling shared tests/*.js public/*.js public/*.webmanifest *.json *.ts *.html README.md docs/*.md",
    "format:check": "prettier --check src server tooling shared tests/*.js public/*.js public/*.webmanifest *.json *.ts *.html README.md docs/*.md",
    "test:updates": "python3 tests/updates.py",
    "test:lan": "python3 tests/run-browser-fixture.py tests/lan.py",
    "test:realtime": "python3 tests/run-browser-fixture.py tests/realtime.py",
    "test:requests": "python3 tests/run-browser-fixture.py tests/requests.py"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "idb": "^8.0.3",
    "jspdf": "^3.0.3",
    "lucide-react": "^0.468.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
